# Copier ce fichier vers .env.local en développement. Ne jamais committer les secrets.
# Neon : URL PostgreSQL serverless, SSL requis (connexion pooled recommandée sur Vercel).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Auth.js v5. Générer avec: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Commission en points de base : 800 = 8 %.
PLATFORM_COMMISSION_BPS=800
CRON_SECRET="replace-with-another-random-secret"

# Mode mock uniquement en local. Ne pas activer sur le déploiement public de production.
ALLOW_MOCK_PAYMENTS=true
MOCK_WEBHOOK_SECRET="replace-with-a-different-random-secret"
# Paiement réel (étape 5) — agrégateur CinetPay : Orange Money, MTN, Moov, Wave et carte sur page
# hébergée (aucune donnée de carte chez nous). Laisser vide tant que le compte marchand n'est pas validé :
# les moyens mobile money et carte ne sont alors pas proposés en production.
# Notifications : https://<domaine>/api/webhooks/payments/cinetpay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
# Facultatif : autre point d'accès (environnement de test fourni par le prestataire).
CINETPAY_API_BASE=

# Vercel Blob : créer deux stores séparés, un public (images produits), un privé (documents vendeurs).
BLOB_PUBLIC_READ_WRITE_TOKEN=
BLOB_PRIVATE_READ_WRITE_TOKEN=

# Bootstrap du premier SuperAdmin du back office (mot de passe haché bcrypt; ne jamais committer de vraies valeurs).
# Fournir des valeurs réelles uniquement dans l’environnement privé utilisé pour exécuter le seed.
SEED_SUPERADMIN_NAME="Administrateur principal"
SEED_SUPERADMIN_EMAIL="admin@your-company.example"
SEED_SUPERADMIN_PASSWORD="replace-with-a-unique-random-password-of-16-chars-minimum"
ALLOW_PRODUCTION_ADMIN_SEED=false

# Ancien seed marketplace de démonstration, séparé; sandbox uniquement.
SEED_DEMO_PASSWORD="change-this-dev-only-password"
ALLOW_DEMO_SEED=false

# --- API REST v1 (/api/v1) -------------------------------------------------
# Signature des jetons d'accès de l'API d'administration (32 caractères minimum).
# Générer avec : openssl rand -base64 48. Sans cette variable, l'API admin est désactivée.
ADMIN_API_JWT_SECRET=
# Rotation sans coupure : mettre l'ancien secret ici pendant le changement, puis le retirer.
ADMIN_API_JWT_SECRET_PREVIOUS=
# Back-office (projet Vercel « mybigmarket-adminnew ») : mêmes valeurs ADMIN_API_JWT_SECRET que la
# boutique, et adresse de l'API. Les écrans catalogue, prix et stocks passent par l'API v1.
ADMIN_API_BASE_URL=https://mybigmarket.vercel.app
# Origines autorisées (CORS), séparées par des virgules. Jamais « * ».
ADMIN_CORS_ALLOWED_ORIGINS=https://mybigmarket-adminnew.vercel.app
CORS_ALLOWED_ORIGINS=
# Chiffrement des secrets TOTP (32 octets en base64), partagé avec le back-office.
ADMIN_TOTP_ENCRYPTION_KEY=

# Limitation de débit partagée. Sans Upstash, PostgreSQL est utilisé (table rate_limit_buckets).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# E-mails transactionnels (file d'attente email_queue).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=mybigmarket

# Niveau de journalisation : debug, info, warn, error.
LOG_LEVEL=info

